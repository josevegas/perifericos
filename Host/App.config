<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      Cola de la impresora térmica de la caja. Es el mismo ajuste que lee la
      librería (ImpresionService.Impresora).

      Vacío = se busca una impresora que se PAREZCA a una térmica por el nombre
      (TM-T, TM-U, EPSON TM, RECEIPT, TICKET, THERMAL, POS-). Si no hay ninguna,
      la impresión se rechaza con la lista de las instaladas.

      Nota: NUNCA se usa la impresora predeterminada de Windows. En un grifo la
      predeterminada suele ser la láser de la oficina, y el ESC/POS crudo sale
      por ahí como varias hojas de basura.

      Pon el nombre exacto tal como aparece en "Impresoras y escáneres".
    -->
    <add key="impresora_ticket" value="" />
  </appSettings>
</configuration>
